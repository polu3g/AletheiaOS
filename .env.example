# AletheiaOS — environment configuration template
# Copy this to .env and fill in your values.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=AletheiaOS
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default — zero-config local dev)
DATABASE_URL=sqlite:///./aletheia.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/aletheia

# ── Ontology / RDF ────────────────────────────────────────────────────────────
ONTOLOGY_PATH=ontology/aletheia.owl
SHAPES_PATH=ontology/shapes.ttl
RDF_STORE_PATH=data/rdf_store.ttl

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list or JSON array. Use ["*"] for open access.
CORS_ORIGINS=["*"]

# ── External HTTP / SSL ───────────────────────────────────────────────────────
# If you are behind a corporate proxy that does SSL inspection you will see:
#   "certificate verify failed: self-signed certificate in certificate chain"
#
# Option A — disable SSL verification (development only, not for production):
#   SSL_VERIFY=false
#
# Option B — supply your corporate CA bundle (preferred):
#   SSL_CA_BUNDLE=/etc/ssl/certs/corp-ca.pem
#
SSL_VERIFY=true
# SSL_CA_BUNDLE=
