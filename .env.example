# AletheiaOS — environment configuration template
# Copy this to .env and fill in your values.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=AletheiaOS
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default — zero-config local dev)
DATABASE_URL=sqlite:///./aletheia.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/aletheia

# ── Ontology / RDF ────────────────────────────────────────────────────────────
ONTOLOGY_PATH=ontology/aletheia.owl
SHAPES_PATH=ontology/shapes.ttl
RDF_STORE_PATH=data/rdf_store.ttl

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list or JSON array. Use ["*"] for open access.
CORS_ORIGINS=["*"]
