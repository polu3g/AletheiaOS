<?xml version="1.0"?>
<!DOCTYPE rdf:RDF [
    <!ENTITY owl  "http://www.w3.org/2002/07/owl#" >
    <!ENTITY rdf  "http://www.w3.org/1999/02/22-rdf-syntax-ns#" >
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#" >
    <!ENTITY xsd  "http://www.w3.org/2001/XMLSchema#" >
    <!ENTITY ale  "http://aletheia.ai/ontology#" >
]>
<rdf:RDF
    xmlns:owl ="http://www.w3.org/2002/07/owl#"
    xmlns:rdf ="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:xsd ="http://www.w3.org/2001/XMLSchema#"
    xmlns:ale ="http://aletheia.ai/ontology#">

  <!-- Ontology declaration -->
  <owl:Ontology rdf:about="http://aletheia.ai/ontology">
    <rdfs:label>AletheiaOS Cognitive Ontology</rdfs:label>
    <rdfs:comment>Ontology for the AletheiaOS neuro-symbolic cognitive architecture.</rdfs:comment>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </owl:Ontology>

  <!-- ══════════════════════════════════════
       Classes
  ══════════════════════════════════════ -->

  <owl:Class rdf:about="&ale;Observation">
    <rdfs:label>Observation</rdfs:label>
    <rdfs:comment>A raw sensory or linguistic input to the cognitive system.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="&ale;Inference">
    <rdfs:label>Inference</rdfs:label>
    <rdfs:comment>A symbolic conclusion derived from one or more observations.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="&ale;Plan">
    <rdfs:label>Plan</rdfs:label>
    <rdfs:comment>An ordered sequence of actions generated in response to an inference.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="&ale;Action">
    <rdfs:label>Action</rdfs:label>
    <rdfs:comment>An atomic executable step within a plan.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="&ale;EnvironmentCondition">
    <rdfs:label>EnvironmentCondition</rdfs:label>
    <rdfs:subClassOf rdf:resource="&ale;Observation"/>
  </owl:Class>

  <owl:Class rdf:about="&ale;RoadCondition">
    <rdfs:label>RoadCondition</rdfs:label>
    <rdfs:subClassOf rdf:resource="&ale;EnvironmentCondition"/>
  </owl:Class>

  <owl:Class rdf:about="&ale;SafetyCondition">
    <rdfs:label>SafetyCondition</rdfs:label>
    <rdfs:subClassOf rdf:resource="&ale;EnvironmentCondition"/>
  </owl:Class>

  <owl:Class rdf:about="&ale;VisibilityCondition">
    <rdfs:label>VisibilityCondition</rdfs:label>
    <rdfs:subClassOf rdf:resource="&ale;EnvironmentCondition"/>
  </owl:Class>

  <owl:Class rdf:about="&ale;TrafficCondition">
    <rdfs:label>TrafficCondition</rdfs:label>
    <rdfs:subClassOf rdf:resource="&ale;EnvironmentCondition"/>
  </owl:Class>

  <!-- ══════════════════════════════════════
       Object Properties
  ══════════════════════════════════════ -->

  <owl:ObjectProperty rdf:about="&ale;hasInference">
    <rdfs:label>hasInference</rdfs:label>
    <rdfs:domain rdf:resource="&ale;Observation"/>
    <rdfs:range rdf:resource="&ale;Inference"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&ale;hasPlan">
    <rdfs:label>hasPlan</rdfs:label>
    <rdfs:domain rdf:resource="&ale;Inference"/>
    <rdfs:range rdf:resource="&ale;Plan"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="&ale;requiresAction">
    <rdfs:label>requiresAction</rdfs:label>
    <rdfs:domain rdf:resource="&ale;Plan"/>
    <rdfs:range rdf:resource="&ale;Action"/>
  </owl:ObjectProperty>

  <!-- ══════════════════════════════════════
       Datatype Properties
  ══════════════════════════════════════ -->

  <owl:DatatypeProperty rdf:about="&ale;confidence">
    <rdfs:label>confidence</rdfs:label>
    <rdfs:domain rdf:resource="&ale;Inference"/>
    <rdfs:range rdf:resource="&xsd;float"/>
    <rdfs:comment>Confidence score in [0, 1] for a derived inference.</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ale;timestamp">
    <rdfs:label>timestamp</rdfs:label>
    <rdfs:range rdf:resource="&xsd;dateTime"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="&ale;rawText">
    <rdfs:label>rawText</rdfs:label>
    <rdfs:domain rdf:resource="&ale;Observation"/>
    <rdfs:range rdf:resource="&xsd;string"/>
  </owl:DatatypeProperty>

  <!-- ══════════════════════════════════════
       Named Individuals — Inference Types
  ══════════════════════════════════════ -->

  <ale:RoadCondition rdf:about="&ale;road_slippery">
    <rdfs:label>Road Slippery</rdfs:label>
  </ale:RoadCondition>

  <ale:RoadCondition rdf:about="&ale;road_clear">
    <rdfs:label>Road Clear</rdfs:label>
    <owl:differentFrom rdf:resource="&ale;road_slippery"/>
  </ale:RoadCondition>

  <ale:TrafficCondition rdf:about="&ale;traffic_congestion">
    <rdfs:label>Traffic Congestion</rdfs:label>
  </ale:TrafficCondition>

  <ale:SafetyCondition rdf:about="&ale;obstacle_detected">
    <rdfs:label>Obstacle Detected</rdfs:label>
  </ale:SafetyCondition>

  <ale:SafetyCondition rdf:about="&ale;emergency_alert">
    <rdfs:label>Emergency Alert</rdfs:label>
  </ale:SafetyCondition>

  <ale:VisibilityCondition rdf:about="&ale;low_visibility">
    <rdfs:label>Low Visibility</rdfs:label>
  </ale:VisibilityCondition>

  <ale:Observation rdf:about="&ale;general_observation">
    <rdfs:label>General Observation</rdfs:label>
  </ale:Observation>

</rdf:RDF>
